From 422ab3f8ef1ada1d2e7cb3863c949e8829588bb9 Mon Sep 17 00:00:00 2001
From: mixadod <mixadod123@gmail.com>
Date: Thu, 22 Oct 2026 18:54:00 +0300
Subject: [PATCH] drm: async page flips for tearing

DrmCompositor::set_allow_tearing(true): a frame that changes only the
primary plane's buffer (same src, dst, format; no other plane touched)
is flipped with DRM_MODE_PAGE_FLIP_ASYNC, a request carrying FB_ID
alone, the one change the kernel takes in an async flip. The buffer's
sync point is waited for on the CPU, as the request has no IN_FENCE_FD.
A flip the kernel refuses falls back to a normal one and async flips
stay off until set_allow_tearing is called with a new value. Atomic
surfaces only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/backend/drm/compositor/mod.rs | 76 +++++++++++++++++++++++++++++++
 src/backend/drm/surface/atomic.rs | 34 ++++++++++++++
 src/backend/drm/surface/mod.rs    | 16 +++++++
 3 files changed, 126 insertions(+)

diff --git a/src/backend/drm/compositor/mod.rs b/src/backend/drm/compositor/mod.rs
index 3f471cf3..0ea83d4f 100644
--- a/src/backend/drm/compositor/mod.rs
+++ b/src/backend/drm/compositor/mod.rs
@@ -648,6 +648,36 @@ impl<B: Buffer, F: Framebuffer> FrameState<B, F> {
     }
 }
 
+impl<B: Buffer, F: Framebuffer> FrameState<B, F> {
+    /// angel-smithay: the primary plane's new framebuffer (and what to wait for before showing
+    /// it) when nothing else changed since `previous`: all an async page flip may change.
+    fn async_flip(
+        &self,
+        previous: &Self,
+        primary: plane::Handle,
+    ) -> Option<(framebuffer::Handle, Option<SyncPoint>)> {
+        let mut flip = None;
+        for (handle, state) in &self.planes {
+            if *handle != primary {
+                if !state.skip {
+                    return None;
+                }
+                continue;
+            }
+            let config = state.config.as_ref().filter(|_| !state.skip)?;
+            let before = previous.plane_state(primary)?.config.as_ref()?;
+            if !config.is_compatible(before) {
+                return None;
+            }
+            flip = Some((
+                *config.buffer.as_ref(),
+                config.sync.as_ref().map(|(sync, _)| sync.clone()),
+            ));
+        }
+        flip
+    }
+}
+
