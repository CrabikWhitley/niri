             current_frame,
             pending_frame: None,
@@ -2545,10 +2582,38 @@ where
         } = self.queued_frame.take().unwrap();
 
         let allow_partial_update = prepared_frame.kind == PreparedFrameKind::Partial;
+        let async_flip = (self.allow_tearing
+            && !self.async_flip_failed
