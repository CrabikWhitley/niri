+        } else if let Some((fb, sync)) = async_flip {
+            // the async request carries no IN_FENCE_FD: wait for the buffer here
+            if let Some(Err(err)) = sync.map(|sync| sync.wait()) {
+                warn!("error waiting for an async flip's buffer: {err:?}");
+            }
+            match self.surface.page_flip_async(self.surface.plane(), fb, true) {
+                Ok(()) => Ok(()),
+                Err(err) => {
+                    warn!("async page flip refused, tearing off until asked again: {err}");
+                    self.async_flip_failed = true;
+                    prepared_frame.frame.page_flip(
+                        &self.surface,
+                        self.supports_fencing,
+                        allow_partial_update,
+                        true,
+                    )
+                }
+            }
         } else {
             prepared_frame
                 .frame
@@ -2731,6 +2796,17 @@ where
         self.surface.vrr_supported(conn).map_err(FrameError::DrmError)
     }
 
+    /// angel-smithay: allow async ("tearing") page flips: a frame that changes only the primary
+    /// plane's buffer is shown at once instead of at the next vblank. Atomic surfaces only; a
+    /// flip the kernel refuses falls back to a normal one, and async flips stay off until this
+    /// is set again.
+    pub fn set_allow_tearing(&mut self, allow: bool) {
+        if allow != self.allow_tearing {
+            self.async_flip_failed = false;
+        }
+        self.allow_tearing = allow;
+    }
+
     /// Returns if Variable Refresh Rate is currently enabled for frames composed by this [`DrmCompositor`].
     pub fn vrr_enabled(&self) -> bool {
         self.surface.vrr_enabled()
diff --git a/src/backend/drm/surface/atomic.rs b/src/backend/drm/surface/atomic.rs
index e63f0efa..4cf9d901 100644
--- a/src/backend/drm/surface/atomic.rs
+++ b/src/backend/drm/surface/atomic.rs
@@ -924,6 +924,40 @@ impl AtomicDrmSurface {
         res
     }
 
+    /// angel-smithay: an async ("tearing") page flip that changes only `plane`'s framebuffer,
+    /// the only change the kernel takes with `DRM_MODE_PAGE_FLIP_ASYNC`.
+    pub fn page_flip_async(
+        &self,
+        plane: plane::Handle,
+        fb: framebuffer::Handle,
+        event: bool,
+    ) -> Result<(), Error> {
+        if !self.active.load(Ordering::SeqCst) {
+            return Err(Error::DeviceInactive);
+        }
+
+        let prop_mapping = self.prop_mapping.read().unwrap();
+        let mut req = AtomicModeReq::new();
+        req.add_property(
+            plane,
+            prop_mapping.plane_prop_handle(plane, "FB_ID")?,
+            property::Value::Framebuffer(Some(fb)),
+        );
+
+        let mut flags = AtomicCommitFlags::PAGE_FLIP_ASYNC | AtomicCommitFlags::NONBLOCK;
+        if event {
+            flags |= AtomicCommitFlags::PAGE_FLIP_EVENT;
+        }
+        trace!(?plane, ?fb, "Queueing async page flip");
+        self.fd.atomic_commit(flags, req).map_err(|source| {
+            Error::Access(AccessError {
+                errmsg: "Async page flip commit failed",
+                dev: self.fd.dev_path(),
+                source,
+            })
+        })
+    }
+
     // this helper function disconnects the plane.
     // this is mostly used to remove the contents quickly, e.g. on tty switch,
     // as other compositors might not make use of other planes,
diff --git a/src/backend/drm/surface/mod.rs b/src/backend/drm/surface/mod.rs
index 677fa132..b74b006d 100644
--- a/src/backend/drm/surface/mod.rs
+++ b/src/backend/drm/surface/mod.rs
@@ -449,6 +449,22 @@ impl DrmSurface {
         }
     }
 
+    /// angel-smithay: an async ("tearing") page flip of `plane` to `fb`, nothing else changing.
+    ///
+    /// Atomic surfaces only: a legacy one returns [`Error::UnsupportedPlaneConfiguration`].
+    #[profiling::function]
+    pub fn page_flip_async(
+        &self,
+        plane: plane::Handle,
+        fb: framebuffer::Handle,
+        event: bool,
+    ) -> Result<(), Error> {
+        match &*self.internal {
+            DrmSurfaceInternal::Atomic(surf) => surf.page_flip_async(plane, fb, event),
+            DrmSurfaceInternal::Legacy(_) => Err(Error::UnsupportedPlaneConfiguration(plane)),
+        }
+    }
+
